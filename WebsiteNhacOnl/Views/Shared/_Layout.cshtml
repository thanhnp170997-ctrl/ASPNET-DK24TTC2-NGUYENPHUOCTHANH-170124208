<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewBag.Title - Music Online</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Font Awesome & Boxicons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css" rel="stylesheet" />

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
  

    <style>
        header a:hover, footer a:hover {
            color: #00ffc6;
            transition: 0.3s;
        }
        /* Section Hero Carousel */
        .hero-carousel {
            display: flex;
            justify-content: center; /* căn giữa ngang */
            align-items: center; /* căn giữa dọc */
            width: 100%;
            max-width: 1500px; /* tăng chiều ngang */
            margin: 0 auto; /* căn giữa container */
            padding: 20px 0; /* khoảng cách trên/dưới */
            box-sizing: border-box;
        }

            /* Swiper slides */
            .hero-carousel .swiper {
                width: 100%;
                height: 350px; /* giảm chiều cao, banner thấp hơn */
            }

            .hero-carousel .swiper-slide img {
                width: 100%;
                height: 100%;
                object-fit: cover; /* ảnh lấp đầy khung, không méo */
                display: block;
            }

    </style>

</head>

<body>
    <!-- Header -->

    <header style="background: linear-gradient(90deg, #1e2a2f 0%, #0b0d0f 100%); padding: 15px 50px; display:flex; justify-content:space-between; align-items:center; box-shadow:0 4px 10px rgba(0,0,0,0.3);">
        <div class="logo" style="display:flex; align-items:center; gap:10px; color:#1ed760; font-weight:600; font-size:20px; font-family:'Poppins', sans-serif;">
            <img src="~/Content/images/imgweb/music.png" alt="Logo" style="height:40px;">
            Music Online
        </div>
        <nav style="display:flex; gap:25px;">
            <a href="@Url.Action("Index", "Home")" style="color:#fff; text-decoration:none; font-weight:500;">
                <i class='bx bx-home' style="margin-right:5px;"></i> Trang chủ
            </a>
            <a href="@Url.Action("Index", "BaiHats")" style="color:#fff; text-decoration:none; font-weight:500;">
                <i class='bx bxs-playlist' style="margin-right:5px;"></i> Bài hát
            </a>
            <a href="@Url.Action("Index", "TheLoais")" style="color:#fff; text-decoration:none; font-weight:500;">
                <i class='bx bx-category-alt' style="margin-right:5px;"></i> Thể loại
            </a>
            <a href="@Url.Action("Index", "TaiNhacs")" style="color:#fff; text-decoration:none; font-weight:500;">
                <i class='bx bx-download' style="margin-right:5px;"></i> Tải nhạc
            </a>
            <a href="@Url.Action("Create", "PhanHoiNDs")" style="color:#fff; text-decoration:none; font-weight:500;">
                <i class='bx bx-contact' style="margin-right:5px;"></i> Liên hệ
            </a>
        </nav>
    </header>


  
    <!-- Carousel / Hero -->
    <section class="hero-carousel">
        <div class="swiper mySwiper">
            <div class="swiper-wrapper">
                <div class="swiper-slide"><img src="~/Content/images/imgweb/banner01.jpg" alt="slide1" /></div>
                <div class="swiper-slide"><img src="~/Content/images/imgweb/banner02.jpg" alt="slide2" /></div>
                <div class="swiper-slide"><img src="~/Content/images/imgweb/banner03.jpg" alt="slide3" /></div>
                <div class="swiper-slide"><img src="~/Content/images/imgweb/banner04.jpg" alt="slide4" /></div>
            </div>
            <div class="swiper-pagination"></div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>
    </section>

    <!-- Main Content -->
    <main>
        <div class="render">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->

    <footer style="background: linear-gradient(90deg, #1e2a2f 0%, #0b0d0f 100%); color:#fff; padding:20px 50px; display:flex; justify-content:space-between; align-items:center; box-shadow:0 -3px 10px rgba(0,0,0,0.3); font-family:'Poppins', sans-serif;">
        <p>&copy; @DateTime.Now.Year - Music Online</p>
        <div style="display:flex; gap:15px;">
            <a href="#" style="color:#1ed760; font-size:18px;"><i class="fa fa-envelope"></i></a>
            <a href="#" style="color:#1ed760; font-size:18px;"><i class="fa fa-map-marker-alt"></i></a>
            <a href="#" style="color:#1ed760; font-size:18px;"><i class="fa fa-gamepad"></i></a>
        </div>
    </footer>

    @*<footer>
            <p>&copy; @DateTime.Now.Year - Music Online</p>
            <div>
                <a href="#"><i class="fa fa-envelope"></i></a>
                <a href="#"><i class="fa fa-map-marker-alt"></i></a>
                <a href="#"><i class="fa fa-gamepad"></i></a>
            </div>
        </footer>*@

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

    <script>
        // Initialize Swiper
        const swiper = new Swiper(".mySwiper", {
            slidesPerView: 1,
            spaceBetween: 20,
            loop: true,
            pagination: { el: ".swiper-pagination", clickable: true },
            navigation: { nextEl: ".swiper-button-next", prevEl: ".swiper-button-prev" },
            autoplay: { delay: 3000 }
        });
    </script>
    @RenderSection("Scripts", required: false) <!-- thêm dòng này -->

</body>

</html>
