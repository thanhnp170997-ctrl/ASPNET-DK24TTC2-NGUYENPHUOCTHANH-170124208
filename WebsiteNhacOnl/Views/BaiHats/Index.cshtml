<div class="container py-4" style="max-width:1200px; margin:auto;">
    <h2 class="title">Danh Sách Bài Hát</h2>

    @using (Html.BeginForm())
    {
        <div class="search-bar">
            @Html.TextBox("SearchString", null, new { placeholder = "Nhập tên bài hát...", @class = "form-control" })
            <button type="submit" class="btn btn-primary ms-2"><i class="fa fa-search"></i></button>
        </div>
    }

    <div class="song-grid">
        @foreach (var item in Model)
        {
            <div class="song-card" onclick="setMusicPlay('/Content/music/@item.UrlBH', '@item.HinhAnhBH', '@item.TenBH', '@item.CaSi')">
                <img src="@item.HinhAnhBH" alt="@item.TenBH" />
                <div class="song-info">
                    <h5>@item.TenBH</h5>
                    <p>@item.CaSi</p>
                    <p><small>Tác giả: @item.TacGia</small></p>
                    <div class="song-actions">
                        <a href="@Url.Action("Details", new { id = item.Id })" title="Chi tiết">
                            <i class="fa fa-eye"></i> Chi tiết
                        </a>
                        <a href="@Url.Action("Download", new { fileName = item.UrlBH })" title="Tải về">
                            <i class="fa fa-download"></i> Tải về
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-4">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
    </div>
</div>

<!-- Music Player -->
<div id="playMusic">
    <img id="showI" src="~/Content/images/imgweb/icon_nhac_audio.jpg" />
    <div id="musicInfo">
        <b id="showN">Tên bài hát</b>
        <i id="showS">Ca sĩ</i>
    </div>
    <audio id="audio" controls autoplay loop>
        <source src="~/Content/music/a.mp3" type="audio/mpeg">
    </audio>
</div>

<script>
    function setMusicPlay(musicUrl, imgURL, nameSong, singerSong) {
        document.getElementById("audio").src = musicUrl;
        document.getElementById("showI").src = imgURL;
        document.getElementById("showN").innerText = nameSong;
        document.getElementById("showS").innerText = singerSong;
    }
</script>
