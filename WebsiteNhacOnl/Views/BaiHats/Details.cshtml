<div class="music-container">
    <div class="music-content">
        <!-- Ảnh & Trình phát nhạc -->
        <div class="music-image">
            <img src="@Model.HinhAnhBH" alt="@Model.TenBH">
            <div class="music-overlay">
                <i class="bi bi-music-note-beamed" style="font-size:40px; color:white;"></i>
            </div>
            <audio controls>
                <source src="/Content/music/@Model.UrlBH" type="audio/mpeg">
                Trình duyệt không hỗ trợ audio.
            </audio>
        </div>

        <!-- Thông tin bài hát -->
        <div class="music-info">
            <h2>@Model.TenBH</h2>
            <p><i class="bi bi-person-fill"></i> Ca sĩ: <b>@Model.CaSi</b></p>
            <p><i class="bi bi-pencil-fill"></i> Tác giả: <b>@Model.TacGia</b></p>
            <p><i class="bi bi-calendar3"></i> Ngày cập nhật: <b>@Model.NgayCapNhat.ToString("dd/MM/yyyy")</b></p>

            <h5 style="margin:15px 0; color:#1ed760;">🎼 Lời bài hát:</h5>
            <div class="lyrics-box">
                <pre>@Model.LoiBH</pre>
            </div>

            <div class="music-buttons">
                <a href="@Url.Action("Index","BaiHats")" class="home">
                    <i class="bi bi-arrow-left"></i> Trở về
                </a>
                <a href="@Url.Action("Download", "BaiHats", new { fileName = Model.UrlBH })" class="download">
                    <i class="bi bi-download"></i> Tải về
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Hover icon nhạc
    const imgContainer = document.querySelector('.music-image');
    const overlay = document.querySelector('.music-overlay');
    imgContainer.addEventListener('mouseenter', () => overlay.style.opacity = 1);
    imgContainer.addEventListener('mouseleave', () => overlay.style.opacity = 0);
</script>
