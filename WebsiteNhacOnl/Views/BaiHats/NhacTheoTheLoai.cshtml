<div class="container py-4" style="max-width:900px; margin:auto;">
    <h2 style="text-align: center; color: white;">Nhạc Theo Thể Loại</h2>
<br />

    @foreach (var item in Model)
    {
        <div class="musicSong"
             data-music="@Url.Content("~/Content/music/" + item.UrlBH)"
             data-img="@Url.Content(item.HinhAnhBH)"
             data-name="@item.TenBH"
             data-singer="@item.CaSi"
             onclick="playMusic(this)">

            <div style="position:relative;">
                <img src="@item.HinhAnhBH" alt="@item.TenBH" />
                @*<div class="overlay">
                    <i class="fa fa-play" style="font-size:24px; color:white;"></i>
                </div>*@
            </div>

            <div class="music-info">
                <h5>@item.TenBH</h5>
                <small>@item.CaSi</small>
                <div class="music-actions mt-1">
                    <a href="@Url.Action("Details", "BaiHats", new { id = item.Id })" onclick="event.stopPropagation();">
                        <i class="fa fa-eye"></i>
                    </a>
                    <a href="@Url.Action("Download", "BaiHats", new { fileName = item.UrlBH })" onclick="event.stopPropagation();">
                        <i class="fa fa-cloud-download-alt"></i>
                    </a>
                </div>
            </div>
        </div>
    }

    <div id="playMusic">
        <img id="showI" src="~/Content/images/imgweb/icon_nhac_audio.jpg" />
        <div>
            <b id="showN">Chưa phát</b><br />
            <i id="showS"></i>
        </div>
        <audio id="audio" preload="auto" autoplay loop controls>
            <source src="~/Content/music/a.mp3" type="audio/mpeg" />
        </audio>
    </div>
</div>

<script>
    function playMusic(el) {
        var audio = document.getElementById("audio");
        var image = document.getElementById("showI");
        var name = document.getElementById("showN");
        var singer = document.getElementById("showS");

        audio.src = el.getAttribute('data-music');
        image.src = el.getAttribute('data-img');
        name.innerText = el.getAttribute('data-name');
        singer.innerText = el.getAttribute('data-singer');
        audio.play();
    }
</script>
