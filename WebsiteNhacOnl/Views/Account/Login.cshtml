@using WebsiteNhacOnl.Models
@model LoginViewModel

@{
    ViewBag.Title = "Đăng nhập - MUSIC ADMIN";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewBag.Title</title>

    <link href="~/Areas/Admin/ContentAd/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet" />
    <link href="~/Areas/Admin/ContentAd/css/sb-admin-2.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(180deg, #1b2a2f 0%, #0f1c1f 100%);
            color: #fff;
        }

        .music-image {
            max-width: 100%; /* Giảm kích thước ảnh, có thể đổi 80% → 60% tùy ý */
            height: auto; /* Tự điều chỉnh chiều cao theo tỉ lệ gốc */
            object-fit: contain; /* Giữ nguyên toàn bộ ảnh, không bị cắt góc */
            border-radius: 12px; /* Bo góc nhẹ cho đẹp, có thể bỏ nếu không cần */
        }

        .card {
            background: rgba(255,255,255,0.03);
            border: none;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

            .card .text-gray-900 {
                color: #00ffc6 !important; /* tiêu đề màu xanh kiểu NCT */
            }

        .form-control-user {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: #fff;
        }

            .form-control-user::placeholder {
                color: #bbb;
            }

            .form-control-user:focus {
                background: rgba(255,255,255,0.08);
                border-color: #00ffc6;
                color: #fff;
            }

        .btn-user {
            background: #00ffc6;
            color: #000;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-user:hover {
                background: #00e0aa;
                color: #000;
            }

        .custom-control-label {
            color: #fff;
        }

        .small a {
            color: #00ffc6;
        }

            .small a:hover {
                color: #00e0aa;
            }
    </style>
</head>
<body>

    <div class="container d-flex align-items-center justify-content-center min-vh-100">
        <div class="card o-hidden shadow-lg w-100" style="max-width: 900px;">
            <div class="card-body p-0">
                <div class="row">
                    <!-- Hình ảnh bên trái -->
                    <div class="col-lg-5 d-flex align-items-center justify-content-center">
                        <img src="~/Content/images/imgweb/music.png" alt="Music Image" class="music-image" />
                    </div>

                    <!-- Form đăng nhập bên phải -->
                    <div class="col-lg-7">
                        <div class="p-5">
                            <div class="text-center">
                                <h1 class="h4 text-gray-900 mb-4">Chào mừng bạn quay lại!</h1>
                            </div>

                            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "user" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="form-group">
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-user", @placeholder = "Nhập địa chỉ email..." })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    @Html.PasswordFor(m => m.Password, new { @class = "form-control form-control-user", @placeholder = "Mật khẩu" })
                                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                </div>

                                <div class="form-group">
                                    <div class="custom-control custom-checkbox small">
                                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "custom-control-input", id = "customCheck" })
                                        <label class="custom-control-label" for="customCheck">Nhớ tôi</label>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-user btn-block">Đăng nhập</button>
                            }

                            <hr />
                            <div class="text-center">
                                <a class="small" href="@Url.Action("ForgotPassword", "Account")">Quên mật khẩu?</a>
                            </div>
                            <div class="text-center">
                                <a class="small" href="@Url.Action("Register", "Account")">Tạo tài khoản mới!</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Areas/Admin/ContentAd/vendor/jquery/jquery.min.js"></script>
    <script src="~/Areas/Admin/ContentAd/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Areas/Admin/ContentAd/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/Areas/Admin/ContentAd/js/sb-admin-2.min.js"></script>

</body>
</html>
