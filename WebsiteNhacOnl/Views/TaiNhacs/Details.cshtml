<div class="music-container">
    <div class="music-content">
        <!-- Trình phát nhạc -->
        <div class="music-image">
            <img src="~/Content/images/default_music.jpg" alt="@Model.TenNhac">
            <div class="music-overlay">
                <i class="bi bi-music-note-beamed" style="font-size:40px; color:white;"></i>
            </div>
            <audio controls>
                <source src="/Content/music/@Model.File" type="audio/mpeg">
                Trình duyệt không hỗ trợ audio.
            </audio>
        </div>

        <!-- Thông tin nhạc -->
        <div class="music-info">
            <h2>@Model.TenNhac</h2>
            <p><i class="bi bi-file-earmark-music-fill"></i> File: <b>@Model.File</b></p>
            <p><i class="bi bi-upc-scan"></i> Kích thước: <b>@Model.Size</b></p>
            <p><i class="bi bi-filetype-aac"></i> Loại file: <b>@Model.Type</b></p>

            <div class="music-buttons">
                <a href="@Url.Action("Index", "Home")" class="home">
                    <i class="bi bi-house-fill"></i> Trở về
                </a>
                <a href="@Url.Action("Download","TaiNhac", new { fileName = Model.File })" class="download">
                    <i class="bi bi-download"></i> Tải về
                </a>
            </div>
        </div>
    </div>
</div>
