<div class="container py-4" style="max-width:1200px; margin:auto;">
    <h2 class="download-title">Danh Sách Nhạc Tải Về</h2>

    <div class="row row-custom">
        @foreach (var item in Model)
        {
            <div class="download-card col-lg-3 col-md-4 col-sm-6">
                <i class="fa fa-music"></i>
                <h4>@item.TenNhac</h4>
                <div class="download-actions">
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.Id })
                    <i class="fa fa-eye"></i>

                    @Html.ActionLink("Tải về", "Download", new { fileName = item.File })
                    <i class="fa fa-download"></i>
                </div>
            </div>
        }
    </div>
</div>
