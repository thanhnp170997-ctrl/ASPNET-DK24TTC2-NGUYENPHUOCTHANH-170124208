<div class="container py-5">
    <h2 class="text-center mb-4">
        Liên hệ với <span style="color:#1ed760;">MUSIC ONLINE</span>
    </h2>

    <div class="contact-wrapper">

        <!-- Thông tin liên hệ -->
        <div class="contact-info">
            <h4>Thông tin liên hệ</h4>
            <p><b>🎓 Đại học Trà Vinh</b></p>
            <p>📞 Phone: +84 92.701.809</p>
            <p>✉ Email: admin@gmail.com</p>

            <h4 class="mt-4">Vị trí</h4>
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d16456.84907045425!2d106.33067480155081!3d9.934472542680249!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31a0175ea296facb%3A0x55ded92e29068221!2zVHLGsOG7nW5nIMSQ4bqhaSBI4buNYyBUcsOgIFZpbmg!5e1!3m2!1svi!2sus!4v1742301052169!5m2!1svi!2sus"
                    loading="lazy" allowfullscreen=""></iframe>
        </div>

        <!-- Form phản hồi -->
        <div class="contact-form">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <h4 class="text-center mb-4">Gửi phản hồi của bạn</h4>
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    @Html.LabelFor(model => model.HoTen)
                    @Html.TextBoxFor(model => model.HoTen, new { @class = "form-control", placeholder = "Họ và tên" })
                    @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.NamSinh)
                    @Html.TextBoxFor(model => model.NamSinh, new { @class = "form-control", placeholder = "Năm sinh" })
                    @Html.ValidationMessageFor(model => model.NamSinh, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Sdt)
                    @Html.TextBoxFor(model => model.Sdt, new { @class = "form-control", placeholder = "Số điện thoại" })
                    @Html.ValidationMessageFor(model => model.Sdt, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Mail)
                    @Html.TextBoxFor(model => model.Mail, new { @class = "form-control", placeholder = "Email" })
                    @Html.ValidationMessageFor(model => model.Mail, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.DiaChi)
                    @Html.TextBoxFor(model => model.DiaChi, new { @class = "form-control", placeholder = "Địa chỉ" })
                    @Html.ValidationMessageFor(model => model.DiaChi, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.NdPhanHoi)
                    @Html.TextAreaFor(model => model.NdPhanHoi, new { @class = "form-control", rows = 5, placeholder = "Nội dung phản hồi" })
                    @Html.ValidationMessageFor(model => model.NdPhanHoi, "", new { @class = "text-danger" })
                </div>

                <div class="text-center mt-3">
                    <input type="submit" value="Gửi phản hồi" />
                </div>
            }

            <div class="text-center mt-4 return-home">
                @Html.ActionLink("← Trở lại trang chủ", "Index", "Home")
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
