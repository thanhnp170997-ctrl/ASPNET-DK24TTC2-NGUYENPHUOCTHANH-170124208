<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>@ViewBag.Title - MUSIC ADMIN</title>
    <!-- Custom fonts for this template-->
    <link href="~/Areas/Admin/ContentAd/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">
    <!-- Custom styles for this template-->
    <link href="~/Areas/Admin/ContentAd/css/sb-admin-2.min.css" rel="stylesheet">
    <style>
        .bg-gradient-primary {
            background-color: #1E2A2F !important; /* Màu chính */
            background-image: none !important; /* Tắt gradient mặc định */
        }

        /* Chữ, icon màu trắng */
        .sidebar-dark .nav-item .nav-link,
        .sidebar-dark .sidebar-heading,
        .sidebar-dark .sidebar-brand-text {
            color: #FFFFFF !important;
        }

        /* Icon logo trắng */
        .sidebar-dark .sidebar-brand-icon i {
            color: #FFFFFF !important;
        }

        /* Hiệu ứng hover nhẹ hơn */
        .sidebar-dark .nav-item .nav-link:hover {
            background-color: #26353B !important;
        }

        /* Giữ toggle cùng tông màu */
        #sidebarToggle {
            background-color: #26353B !important;
        }

        /* ✅ Logo và chữ "MUSIC ADMIN" nằm cùng một hàng ngang */
        .sidebar-brand {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 8px; /* Khoảng cách giữa logo và chữ */
        }

            .sidebar-brand img {
                width: 35px; /* Giảm kích thước logo */
                height: auto;
                object-fit: contain; /* Giữ nguyên tỉ lệ, không méo */
                border-radius: 6px; /* Bo nhẹ góc ảnh */
            }

        .sidebar-brand-text {
            font-size: 20px;
            font-weight: 600;
            color: #FFFFFF !important;
            letter-spacing: 0.5px;
        }


    </style>


</head>
<body id="page-top">
    <!-- Page Wrapper -->
    <div id="wrapper">
        <!-- Sidebar -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <!-- Logo -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="#">
                <img src="~/Content/images/imgweb/music.png" alt="Logo" />
                <div class="sidebar-brand-text font-weight-bold">MUSIC ADMIN</div>
            </a>




            <hr class="sidebar-divider">

            <div class="sidebar-heading">Quản lý nhạc</div>

            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "adBaiHats")">
                    <i class="fas fa-music"></i>
                    <span>Thêm Bài Hát</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "adTheLoais")">
                    <i class="fas fa-list-alt"></i>
                    <span>Thể Loại</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "adTaiNhacs")">
                    <i class="fas fa-download"></i>
                    <span>Tải Nhạc</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Index", "adPhanHoiNDs")">
                    <i class="fas fa-envelope"></i>
                    <span>Phản Hồi</span>
                </a>
            </li>

            <hr class="sidebar-divider">

            <div class="sidebar-heading">Tài Khoản</div>

            <li class="nav-item">
                <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseAccount">
                    <i class="fas fa-user"></i>
                    <span>Tài khoản</span>
                </a>
                <div id="collapseAccount" class="collapse">
                    <div class="bg-white py-2 collapse-inner rounded">

                        <a class=" collapse-item" href="Account/Login?ReturnUrl=%2Fadmin">Đăng nhập</a>
                        <a class=" collapse-item" href="Account/register?ReturnUrl=%2Fadmin">Đăng ký</a>

                    </div>
                </div>
            </li>

            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>
        </ul>

        <!-- kết thúc phần đầu -->
        <!-- bao bên ngoài -->
        <div id="content-wrapper" class="d-flex flex-column">
            <!-- Main Content -->
            <div id="content">
                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <!-- Sidebar Toggle (Topbar) -->
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>
                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">
                        <!-- Nav Item - Search Dropdown (Visible Only XS) -->
                        <li class="nav-item dropdown no-arrow d-sm-none">
                            <a class="nav-link dropdown-toggle" href="#" id="searchDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-search fa-fw"></i>
                            </a>
                            <!-- Dropdown - Messages -->
                            <div class="dropdown-menu dropdown-menu-right p-3 shadow animated--grow-in"
                                 aria-labelledby="searchDropdown">
                                <form class="form-inline mr-auto w-100 navbar-search">
                                    <div class="input-group">
                                        <input type="text" class="form-control bg-light border-0 small"
                                               placeholder="Search for..." aria-label="Search"
                                               aria-describedby="basic-addon2">
                                        <div class="input-group-append">
                                            <button class="btn btn-primary" type="button">
                                                <i class="fas fa-search fa-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </li>
                        <div class="topbar-divider d-none d-sm-block"></div>
                        <!-- Tên người vào account  -->
                        <!-- Partial view for login info -->
                        <li class="nav-item dropdown">
                            @Html.Partial("_LoginPartial") <!-- Hiển thị thông tin đăng nhập -->
                        </li>
                    </ul>
                </nav>
                <!-- End of Topbar -->
                <!-- Thân main -->
                <div class="container-fluid">
                    @RenderBody()
                </div>
                <!-- kết thúc phần thân trang -->
            </div>
            <!-- chân trang -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Your Website 2025</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <!-- End of Page Wrapper -->
    <!-- đăng xuất thông báo-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="login.html">Logout</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="~/Areas/Admin/ContentAd/vendor/jquery/jquery.min.js"></script>
    <script src="~/Areas/Admin/ContentAd/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/Areas/Admin/ContentAd/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/Areas/Admin/ContentAd/vendor/chart.js/Chart.min.js"></script>

    <!-- Page level plugins -->
    <script src="~/Areas/Admin/ContentAd/js/sb-admin-2.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/Content/LayoutAd/js/scripts.js"></script>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>

</html>

