@model WebsiteNhacOnl.Models.BaiHat

@{
    ViewBag.Title = "Thêm Bài Hát Mới";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Font Poppins -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Areas/Admin/ContentAd/css/adbaihatstyle.css" rel="stylesheet" />

<div class="create-container">
    <div class="create-card">
        <h2>THÊM BÀI HÁT MỚI</h2>
        <hr />
        <h4 class="msg">@ViewBag.msg</h4>

        @using (Html.BeginForm("Create", "adBaiHats", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                <label>Tên bài hát</label>
                @Html.EditorFor(model => model.TenBH, new { htmlAttributes = new { @class = "form-control", @style = "color:#000;" } })
                @Html.ValidationMessageFor(model => model.TenBH, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Ca sĩ</label>
                @Html.EditorFor(model => model.CaSi, new { htmlAttributes = new { @class = "form-control", @style = "color:#000;" } })
                @Html.ValidationMessageFor(model => model.CaSi, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Tác giả</label>
                @Html.EditorFor(model => model.TacGia, new { htmlAttributes = new { @class = "form-control", @style = "color:#000;" } })
                @Html.ValidationMessageFor(model => model.TacGia, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Ngày cập nhật</label>
                @Html.TextBoxFor(model => model.NgayCapNhat, new { @type = "date", @class = "form-control", @style = "color:#000;", value = DateTime.Now.ToString("yyyy-MM-dd") })
                @Html.ValidationMessageFor(model => model.NgayCapNhat, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Hình ảnh bài hát</label>
                <input type="file" name="img" id="img" accept=".jpg,.png,.gif,.jpeg,.bmp" class="form-control-file" />
                @Html.ValidationMessageFor(model => model.HinhAnhBH, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Lời bài hát</label>
                @Html.TextAreaFor(model => model.LoiBH, new { @class = "form-control", @style = "color:#000;", cols = "60", rows = "10" })
                @Html.ValidationMessageFor(model => model.LoiBH, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Link bài hát (.mp3)</label>
                <input type="file" name="url" id="url" accept=".mp3" class="form-control-file" />
                @Html.ValidationMessageFor(model => model.UrlBH, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Thể loại</label>
                @Html.DropDownList("MaTL", null, htmlAttributes: new { @class = "form-control", @style = "color:#000;" })
                @Html.ValidationMessageFor(model => model.MaTL, "", new { @class = "text-danger" })
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-create">➕ Thêm Mới</button>
                <a href="@Url.Action("Index")" class="btn-back">← Trở Lại</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

