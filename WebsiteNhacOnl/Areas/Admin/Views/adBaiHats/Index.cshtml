<br />
<h1>THÊM BÀI HÁT</h1>

<div class="create-btn">
    @Html.Raw(@Html.ActionLink("[replacetext]", "Create")
        .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/ADD1.png\" height=\"40\"> "))
</div>

<br />

<div class="search-box">
    @using (Html.BeginForm())
    {
        @:Tìm kiếm:
        @Html.TextBox("SearchString")
        <button type="submit">
            <img src="~/Content/images/imgweb/search_icon.png" height="20" width="20" />
        </button>
    }
</div>

<table class="table">
    <tr>
        <th>Tên thể loại</th>
        <th>Tên bài hát</th>
        <th>Ca sĩ</th>
        <th>Tác giả</th>
        <th>Ngày cập nhật</th>
        <th>Hình ảnh bài hát</th>
        <th>Link bài hát</th>
        <th>Thao tác</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.TheLoai.TenTL)</td>
            <td>@Html.DisplayFor(modelItem => item.TenBH)</td>
            <td>@Html.DisplayFor(modelItem => item.CaSi)</td>
            <td>@Html.DisplayFor(modelItem => item.TacGia)</td>
            <td>@item.NgayCapNhat.ToString("dd/MM/yyyy HH:mm:ss")</td>
            <td><img src="@item.HinhAnhBH" style="height:45px" /></td>
            <td>@Html.DisplayFor(modelItem => item.UrlBH)</td>
            <td>
                @Html.Raw(@Html.ActionLink("[replacetext]", "Edit", new { id = item.Id })
                    .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/EDIT1.png\" height=\"25\">"))
                @Html.Raw(@Html.ActionLink("[replacetext]", "Details", new { id = item.Id })
                    .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/DETAILS1.png\" height=\"25\">"))
                @Html.Raw(@Html.ActionLink("[replacetext]", "Delete", new { id = item.Id })
                    .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/tay.png\" height=\"25\">"))
                @Html.Raw(@Html.ActionLink("[replacetext]", "Download", new { fileName = item.UrlBH })
                    .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/xoa.png\" height=\"25\">"))
            </td>
        </tr>
    }
</table>
