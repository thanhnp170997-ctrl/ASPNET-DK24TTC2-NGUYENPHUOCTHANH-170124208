<br />
<h2 style="text-align:center;font-size:32px;color:blue">PHẢN HỒI</h2>
<br />
<table class="table">
    <tr>
        <th>Họ tên</th>
        <th>Năm sinh</th>
        <th>SĐT</th>
        <th>Mail</th>
        <th>Thao tác</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.HoTen)</td>
            <td>@Html.DisplayFor(modelItem => item.NamSinh)</td>
            <td>@Html.DisplayFor(modelItem => item.Sdt)</td>
            <td>@Html.DisplayFor(modelItem => item.Mail)</td>
            <td id="action">
                @Html.Raw(@Html.ActionLink("[replacetext]", "Details", new { id = item.Id })
                    .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/DETAILS1.png\" height=\"25\">"))
                @Html.Raw(@Html.ActionLink("[replacetext]", "Delete", new { id = item.Id })
                    .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/tay.png\" height=\"25\">"))
            </td>
        </tr>
    }
</table>
