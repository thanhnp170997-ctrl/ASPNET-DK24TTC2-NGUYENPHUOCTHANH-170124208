@model WebsiteNhacOnl.Models.PhanHoiND

@{
    ViewBag.Title = "Xoá Phản Hồi";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Areas/Admin/ContentAd/css/adbaihatstyle.css" rel="stylesheet" />

<div class="delete-container">
    <div class="delete-card">
        <h2>XÓA PHẢN HỒI</h2>
        <hr />

        <dl class="detail-list">
            <dt>Họ tên</dt>
            <dd>@Html.DisplayFor(model => model.HoTen)</dd>

            <dt>Năm sinh</dt>
            <dd>@Html.DisplayFor(model => model.NamSinh)</dd>

            <dt>SĐT</dt>
            <dd>@Html.DisplayFor(model => model.Sdt)</dd>

            <dt>Mail</dt>
            <dd>@Html.DisplayFor(model => model.Mail)</dd>

            <dt>Địa chỉ</dt>
            <dd>@Html.DisplayFor(model => model.DiaChi)</dd>

            <dt>Nội dung</dt>
            <dd class="content-box">@Html.DisplayFor(model => model.NdPhanHoi)</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-actions">
                <input type="submit" value="🗑️ Xóa" class="btn-delete" />
                @Html.ActionLink("← Trở Lại", "Index", null, new { @class = "btn-back" })
            </div>
        }
    </div>
</div>

