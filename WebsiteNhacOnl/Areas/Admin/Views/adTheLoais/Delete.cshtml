@model WebsiteNhacOnl.Models.TheLoai

@{
    ViewBag.Title = "Xóa Thể Loại";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Areas/Admin/ContentAd/css/adbaihatstyle.css" rel="stylesheet" />

<div class="delete-container">
    <div class="delete-card">
        <h2>XÓA THỂ LOẠI</h2>
        <hr />

        <dl class="detail-list">
            <dt>Tên thể loại</dt>
            <br />
            <dd>@Html.DisplayFor(model => model.TenTL)</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="form-actions">
                <input type="submit" value="🗑️ Xóa" class="btn-delete" />
                @Html.ActionLink("← Trở Lại", "Index", null, new { @class = "btn-back" })
            </div>
        }
    </div>
</div>

