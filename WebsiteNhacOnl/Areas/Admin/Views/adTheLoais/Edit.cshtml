@model WebsiteNhacOnl.Models.TheLoai

@{
    ViewBag.Title = "Sửa Thể Loại";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Areas/Admin/ContentAd/css/adbaihatstyle.css" rel="stylesheet" />

<div class="edit-container">
    <div class="edit-card">
        <h2>SỬA THỂ LOẠI</h2>
        <hr />
        <h4 class="msg">@ViewBag.msg</h4>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Id)

            <div class="form-group">
                <label>Tên thể loại</label>
                <br />
                @Html.EditorFor(model => model.TenTL, new { htmlAttributes = new { @class = "form-control", @style = "color:#000;" } })
                @Html.ValidationMessageFor(model => model.TenTL, "", new { @class = "text-danger" })
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-edit">✏️ Sửa</button>
                <a href="@Url.Action("Index")" class="btn-back">← Trở Lại</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

