@model WebsiteNhacOnl.Models.TheLoai

@{
    ViewBag.Title = "Chi Tiết Thể Loại";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Areas/Admin/ContentAd/css/adbaihatstyle.css" rel="stylesheet" />

<div class="details-container">
    <div class="details-card">
        <h2>CHI TIẾT THỂ LOẠI</h2>
        <hr />

        <dl class="detail-list">
            <dt>Tên thể loại</dt>
            <br />
            <dd>@Html.DisplayFor(model => model.TenTL)</dd>
        </dl>

        <div class="action-links">
            @Html.ActionLink("✏️ Sửa", "Edit", new { id = Model.Id }, new { @class = "btn-edit" })
            @Html.ActionLink("⬅️ Trở lại", "Index", null, new { @class = "btn-back" })
        </div>
    </div>
</div>

