<h2>DANH SÁCH TẢI NHẠC</h2>
<div class="create-btn">
    @Html.Raw(@Html.ActionLink("[replacetext]", "Create")
        .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/ADD1.png\" height=\"40\"> "))
    </div
    <br />
    <br />

    <table class="table">
        <tr>
            <th>Tên Nhạc</th>
            <th>File</th>
            <th>Size (KB)</th>
            <th>Type</th>
            <th>Thao tác</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.TenNhac)</td>
                <td>@Html.DisplayFor(modelItem => item.File)</td>
                <td>@Html.DisplayFor(modelItem => item.Size)</td>
                <td>@Html.DisplayFor(modelItem => item.Type)</td>
                <td id="action">
                    @Html.Raw(@Html.ActionLink("[replacetext]", "Edit", new { id = item.Id })
                        .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/EDIT1.png\" height=\"25\">"))
                    @Html.Raw(@Html.ActionLink("[replacetext]", "Details", new { id = item.Id })
                        .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/DETAILS1.png\" height=\"25\">"))
                    @Html.Raw(@Html.ActionLink("[replacetext]", "Delete", new { id = item.Id })
                        .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/tay.png\" height=\"25\">"))
                    @Html.Raw(@Html.ActionLink("[replacetext]", "Download", new { fileName = item.File })
                        .ToHtmlString().Replace("[replacetext]", " <img src=\"/Content/images/imgweb/xoa.png\" height=\"25\">"))
                </td>
            </tr>
        }
    </table>
