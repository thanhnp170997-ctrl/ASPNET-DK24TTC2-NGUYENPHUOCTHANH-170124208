@model WebsiteNhacOnl.Models.TaiNhac

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Font chữ sang trọng -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
@*<link href="~/Areas/Admin/ContentAd/css/adbaihatstyle.css" rel="stylesheet" />*@

<br />

<h2 class="page-title">CHI TIẾT TẢI NHẠC</h2>
<hr class="divider" />

<div class="details-container">
    <dl class="detail-list">
        <dt>Tên Nhạc</dt>
        <dd>@Html.DisplayFor(model => model.TenNhac)</dd>

        <dt>File</dt>
        <dd>@Html.DisplayFor(model => model.File)</dd>

        <dt>Size (KB)</dt>
        <dd>@Html.DisplayFor(model => model.Size)</dd>

        <dt>Type</dt>
        <dd>@Html.DisplayFor(model => model.Type)</dd>
    </dl>
</div>

<div class="action-links">
    @Html.ActionLink("✏️ Sửa", "Edit", new { id = Model.Id }, new { @class = "btn-action btn-edit" })
    @Html.ActionLink("⬅️ Trở lại", "Index", null, new { @class = "btn-action btn-back" })
</div>

<style>
    .page-title {
        text-align: center;
        font-size: 32px;
        font-weight: 700;
        color: #FF5722;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .divider {
        width: 60px;
        height: 1px;
        background-color: #FF5722;
        margin: 8px auto 25px auto;
    }

    .details-container {
        max-width: 750px;
        margin: 0 auto;
        background: #fff;
        padding: 30px 40px;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    }

    .detail-list dt {
        font-weight: 600;
        color: #000;
        margin-top: 16px;
    }

    .detail-list dd {
        margin-left: 0;
        margin-bottom: 12px;
        padding: 8px 10px;
        background-color: #f3f6fa;
        border-radius: 8px;
        border: 1px solid #e0e0e0;
        color: #333;
    }

    .action-links {
        text-align: center;
        margin: 20px 0 40px;
        display: flex;
        justify-content: center;
        gap: 20px;
    }

    .btn-action {
        background-color: #FF5722;
        color: white;
        border: none;
        padding: 12px 26px;
        font-size: 16px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-edit {
        background-color: #e64a19;
    }

        .btn-edit:hover {
            background-color: #1565C0;
            transform: scale(1.05);
        }

    .btn-back {
        background-color: #607D8B;
        color: white;
        font-weight: 500;
    }

        .btn-back:hover {
            background-color: #455A64;
            transform: translateY(-2px);
        }
</style>
