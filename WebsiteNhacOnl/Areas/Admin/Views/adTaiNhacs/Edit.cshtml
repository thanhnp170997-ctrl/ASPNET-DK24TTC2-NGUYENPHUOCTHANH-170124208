@model WebsiteNhacOnl.Models.TaiNhac

@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

@*<link href="~/Areas/Admin/ContentAd/css/adbaihatstyle.css" rel="stylesheet" />*@

<br />
<h2 class="page-title">SỬA TẢI NHẠC</h2>
<hr class="divider" />

@using (Html.BeginForm("Edit", "adTaiNhacs", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)

    <div class="form-container">

        <div class="form-group">
            <label class="form-label">Tên Nhạc</label>
            @Html.EditorFor(model => model.TenNhac, new { htmlAttributes = new { @class = "form-control custom-input" } })
            @Html.ValidationMessageFor(model => model.TenNhac, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="form-label">File</label>
            <input type="file" name="files" id="files" class="form-control custom-input" />
            @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="form-label">Size (KB)</label>
            @Html.EditorFor(model => model.Size, new { htmlAttributes = new { @class = "form-control custom-input" } })
            @Html.ValidationMessageFor(model => model.Size, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="form-label">Type</label>
            @Html.EditorFor(model => model.Type, new { htmlAttributes = new { @class = "form-control custom-input" } })
            @Html.ValidationMessageFor(model => model.Type, "", new { @class = "text-danger" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-save">💾 Lưu thay đổi</button>
            <a href="@Url.Action("Index")" class="btn-back">← Trở Lại</a>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<style>
    .page-title {
        text-align: center;
        font-size: 32px;
        font-weight: 700;
        color: #FF5722;
        letter-spacing: 1px;
    }

    .divider {
        width: 60px;
        height: 1px;
        background-color: #FF5722;
        margin: 8px auto 25px auto;
    }

    .form-container {
        max-width: 700px;
        margin: 0 auto;
        background: #fff;
        padding: 30px 40px;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    }

    .form-label {
        font-weight: 700;
        margin-bottom: 6px;
        color: #000;
        display: block;
    }

    .custom-input {
        border-radius: 8px;
        border: 1px solid #ccc;
        padding: 10px;
        width: 100%;
        color: #000;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .custom-input:focus {
            border-color: #FF5722;
            box-shadow: 0 0 4px rgba(255, 87, 34, 0.4);
            outline: none;
        }

    .form-group {
        margin-bottom: 20px;
    }

    .form-actions {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
    }

    .btn-save {
        background-color: #FF5722;
        color: white;
        border: none;
        padding: 12px 26px;
        font-size: 16px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .btn-save:hover {
            background-color: #e64a19;
            transform: translateY(-2px);
        }

    .btn-back {
        text-decoration: none;
        background-color: #607D8B;
        color: white;
        padding: 12px 26px;
        font-size: 16px;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-weight: 500;
    }

        .btn-back:hover {
            background-color: #455A64;
            transform: translateY(-2px);
        }

    .text-danger {
        color: #d32f2f;
        font-size: 14px;
    }
</style>
