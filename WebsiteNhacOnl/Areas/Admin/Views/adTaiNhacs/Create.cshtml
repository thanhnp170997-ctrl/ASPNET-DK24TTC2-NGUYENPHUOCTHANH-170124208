@model WebsiteNhacOnl.Models.TaiNhac

@{
    ViewBag.Title = "Thêm tải nhạc";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Font Poppins -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/Areas/Admin/ContentAd/css/adbaihatstyle.css" rel="stylesheet" />

<div class="create-container">
    <div class="create-card">
        <h2>THÊM TẢI NHẠC MỚI</h2>
        <hr />
        <h4 class="msg">@ViewBag.msg</h4>

        @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                <label>Tên Nhạc</label>
                @Html.EditorFor(model => model.TenNhac, new { htmlAttributes = new { @class = "form-control", @style = "color:#000;" } })
                @Html.ValidationMessageFor(model => model.TenNhac, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>File</label>
                <input type="file" name="files" id="files" multiple="multiple" class="form-control-file" />
                @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Size (KB)</label>
                @Html.EditorFor(model => model.Size, new { htmlAttributes = new { @class = "form-control", @style = "color:#000;" } })
                @Html.ValidationMessageFor(model => model.Size, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Type</label>
                @Html.EditorFor(model => model.Type, new { htmlAttributes = new { @class = "form-control", @style = "color:#000;" } })
                @Html.ValidationMessageFor(model => model.Type, "", new { @class = "text-danger" })
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-create">➕ Thêm Mới</button>
                <a href="@Url.Action("Index")" class="btn-back">← Trở Lại</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

